# ========================================================
# Production Environment Variables Example
# ========================================================

# Server Configuration
PORT=5001
NODE_ENV=production
FRONTEND_URL=https://your-production-frontend-domain.com

# --------------------------------------------------------
# Option A: Single Connection String (Render / Supabase / Neon / Railway)
# --------------------------------------------------------
# DATABASE_URL=postgresql://postgres:your_password@your-db-host.com:5432/your_db_name?sslmode=require

# --------------------------------------------------------
# Option B: Individual PostgreSQL Connection Variables
# --------------------------------------------------------
DB_NAME=your_production_db
DB_USER=your_db_username
DB_PASSWORD=your_db_secure_password
DB_HOST=your_production_db_host.com
DB_PORT=5432
DB_SSL=true

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secure_secret_key_32chars
JWT_EXPIRES_IN=7d

# Default Production Admin Credentials (Used by migration / seed)
ADMIN_EMAIL=medkit@gmail.com
ADMIN_PASSWORD=Medkit@123
ADMIN_NAME=MedKit Admin
